# ---------------------------------------
# Node dependencies stage
# ---------------------------------------
FROM public.ecr.aws/docker/library/node:22-alpine AS frontend-dependencies
WORKDIR /app

# Install pnpm 10 (latest stable, works reliably in Alpine)
RUN npm install -g pnpm@10

# Copy package.json and lockfile to leverage caching
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# ---------------------------------------
# Build Nuxt (frontend) stage
# ---------------------------------------
FROM public.ecr.aws/docker/library/node:22-alpine AS frontend-builder
WORKDIR /app

# Install pnpm globally again with a stable version (it can reuse the cache if not changed)
RUN npm install -g pnpm@10

# Copy over source files and node_modules from dependencies stage
COPY frontend .
COPY --from=frontend-dependencies /app/node_modules ./node_modules
RUN pnpm build

# ---------------------------------------
# Bun server dependencies. No Go toolchain.
# ---------------------------------------
FROM oven/bun:1-alpine AS server-dependencies
WORKDIR /app
COPY server/package.json server/bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:1-alpine AS layout
USER root
RUN mkdir -p /data /app && chown -R 65532:65532 /data /app

# ---------------------------------------
# Production stage — distroless Bun serving the Vue UI. No compiled API binary.
# ---------------------------------------
FROM oven/bun:1-distroless
ENV HBOX_MODE=production
ENV HBOX_STORAGE_CONN_STRING=file:///?no_tmp_dir=true
ENV HBOX_STORAGE_PREFIX_PATH=data
ENV HBOX_DATABASE_SQLITE_PATH=/data/homebox.db?_pragma=busy_timeout=2000&_pragma=journal_mode=WAL&_fk=1&_time_format=sqlite
ENV HBOX_MIGRATIONS_DIR=/app/migrations/sqlite3
ENV HBOX_STATIC_DIR=/app/frontend/.output/public

COPY --from=layout --chown=65532:65532 /data /data
COPY --from=layout --chown=65532:65532 /app /app
COPY --from=server-dependencies --chown=65532:65532 /app/node_modules /app/node_modules
COPY --chown=65532:65532 server/package.json server/bun.lock /app/
COPY --chown=65532:65532 server/src /app/src
COPY --chown=65532:65532 server/healthcheck.ts /app/healthcheck.ts
COPY --chown=65532:65532 backend/internal/data/migrations/sqlite3 /app/migrations/sqlite3
COPY --chown=65532:65532 backend/internal/core/currencies/currencies.json /app/currencies.json
COPY --from=frontend-builder --chown=65532:65532 /app/.output/public /app/frontend/.output/public

LABEL Name=homebox Version=0.0.1
LABEL org.opencontainers.image.source="https://github.com/sysadminsmedia/homebox"

EXPOSE 7745
WORKDIR /app
VOLUME [ "/data" ]

USER 65532
ENTRYPOINT [ "/usr/local/bin/bun", "/app/src/index.ts" ]
CMD [ "/data/config.yml" ]

# JSON exec-form healthcheck (no shell, no wget, no Go helper binary)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/bun", "/app/healthcheck.ts", "http://127.0.0.1:7745/api/v1/status"]
