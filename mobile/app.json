{
  "expo": {
    "name": "HomeBox",
    "slug": "homebox-mobile",
    "scheme": "homebox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "software.homebox.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "software.homebox.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b5e52"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeBox attaches photos you pick to items on your server.",
          "cameraPermission": "HomeBox uses the camera to photograph items and to scan barcodes and QR labels.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HomeBox uses the camera to photograph items and to scan barcodes and QR labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1b5e52",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-updates",
      "./plugins/forbid-local-inventory.cjs",
      "./plugins/lan-http.cjs",
      "./plugins/sideload-signing.cjs"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
