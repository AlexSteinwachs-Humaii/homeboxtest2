{
  "name": "homebox-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:apk": "sh ./scripts/android-apk.sh",
    "export:web": "expo export --platform web --output-dir dist",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test src/api/client.test.ts src/session/session.test.ts src/inventory/inventory.test.ts src/photos/photos.test.ts src/scan/lookup.test.ts src/scan/scan-lock.test.ts src/maintenance/maintenance.test.ts src/native/binary.test.ts src/inventory-boundary.test.ts src/screens/shared-screens.test.ts src/web-shell.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "typescript": "~5.9.2"
  }
}
