{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["react"]
  },
  "include": ["app", "src", "expo-env.d.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
